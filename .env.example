# Copy to .env for local dev. In production these are Worker secrets
# (`wrangler secret put <NAME>`), never committed. See SETUP.md for how to
# obtain each one.

# Neon Postgres connection string (pooled), from the Neon console.
NUXT_DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/salesforce_passport?sslmode=require"

# Random 32+ byte string used to sign session cookies. Generate with:
#   openssl rand -base64 32
NUXT_SESSION_SECRET=""

# --- Read-only Salesforce demo org (JWT Bearer flow) ---
# Off by default. The demo route 404s until NUXT_PUBLIC_DEMO_ORG_ENABLED=true
# and the three SF_* values below are all set. See SETUP.md § "Read-only demo
# org access" for how to create the Connected App, the integration user, and
# the "PSK Demo Read Only" permission set that scopes what it can see.
NUXT_PUBLIC_DEMO_ORG_ENABLED=false
NUXT_SF_LOGIN_URL="https://login.salesforce.com"
NUXT_SF_CLIENT_ID=""
NUXT_SF_USERNAME=""
# The PEM private key whose matching cert is uploaded to the Connected App.
# Keep the newlines — either paste literally (most shells/dotenv preserve a
# multi-line quoted value) or store as base64 and decode in server/utils/sf.ts.
NUXT_SF_PRIVATE_KEY=""
