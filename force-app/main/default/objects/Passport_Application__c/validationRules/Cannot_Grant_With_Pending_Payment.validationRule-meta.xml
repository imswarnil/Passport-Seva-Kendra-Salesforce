<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cannot_Grant_With_Pending_Payment</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISPICKVAL(Status__c,"Granting"), NOT(ISPICKVAL(Payment_Status__c,"Paid")) )</errorConditionFormula>
    <errorMessage>Payment must be Paid before the application can move to Granting.</errorMessage>
</ValidationRule>
