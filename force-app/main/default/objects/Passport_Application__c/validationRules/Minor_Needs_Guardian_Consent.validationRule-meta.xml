<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Minor_Needs_Guardian_Consent</fullName>
    <active>true</active>
    <errorConditionFormula>AND( Applied_For_Minor__c, NOT(Guardian_Consent__c), NOT(ISPICKVAL(Status__c,&quot;Draft&quot;)) )</errorConditionFormula>
    <errorMessage>Guardian Consent is required for a minor application before submission.</errorMessage>
</ValidationRule>
