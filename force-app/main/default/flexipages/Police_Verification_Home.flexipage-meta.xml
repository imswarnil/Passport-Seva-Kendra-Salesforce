<?xml version="1.0" encoding="UTF-8"?>
<FlexiPage xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Home page for the Police Verification Console -- reuses the queue-aware My Work component so anyone in the Police_Verification queue sees their work automatically.</description>
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentName>c:pskMyWorkQueue</componentName>
                <identifier>c_pskMyWorkQueue</identifier>
            </componentInstance>
        </itemInstances>
        <name>top</name>
        <type>Region</type>
    </flexiPageRegions>
    <flexiPageRegions>
        <name>bottomLeft</name>
        <type>Region</type>
    </flexiPageRegions>
    <flexiPageRegions>
        <name>bottomRight</name>
        <type>Region</type>
    </flexiPageRegions>
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentName>c:pskHomeSidebarSummary</componentName>
                <identifier>c_pskHomeSidebarSummary</identifier>
            </componentInstance>
        </itemInstances>
        <name>sidebar</name>
        <type>Region</type>
    </flexiPageRegions>
    <masterLabel>Police Verification Home</masterLabel>
    <template>
        <name>home:desktopTemplate</name>
    </template>
    <type>HomePage</type>
</FlexiPage>
