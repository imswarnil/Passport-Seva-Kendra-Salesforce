    "FORMULA10" : {
      "action" : "formula",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "datediff(CreatedDate, Id_formula) ",
          "label" : "Account Tenure",
          "name" : "AccountTenure",
          "precision" : 10,
          "scale" : 0,
          "type" : "NUMBER"
        } ]
      },
      "sources" : [ "FORMULA9" ]
    },
    "FORMULA11" : {
      "action" : "formula",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "case when IsClosed = 'false' then datediff(now(), CreatedDate) else datediff(CloseDate, CreatedDate) end",
          "label" : "Age",
          "name" : "Age",
          "precision" : 10,
          "scale" : 0,
          "type" : "NUMBER"
        } ]
      },
      "sources" : [ "FORMULA10" ]
    },
    "FORMULA12" : {
      "action" : "formula",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "datediff(now(), CloseDate)",
          "label" : "Days Since Close",
          "name" : "DaysSinceCLose",
          "precision" : 10,
          "scale" : 0,
          "type" : "NUMBER"
        } ]
      },
      "sources" : [ "FORMULA11" ]
    },
    "FORMULA13" : {
      "action" : "computeRelative",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : " case when lag(IsClosed) = 'true' and lag(IsWon) = 'true' then 1 else 0 end",
          "label" : "OpporutnityWon",
          "name" : "Id_formula2",
          "precision" : 10,
          "scale" : 0,
          "type" : "NUMBER"
        } ],
        "orderBy" : [ {
          "direction" : "ASC",
          "fieldName" : "CloseDate"
        } ],
        "partitionBy" : [ "AccountId" ]
      },
      "sources" : [ "FORMULA12" ]
    },
    "FORMULA14" : {
      "action" : "computeRelative",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "case when lag(IsClosed) = 'true' and lag(IsWon) ='false' then 1 else 0 end",
          "label" : "Opportunity is Lost",
          "name" : "Id_formula2_formula",
          "precision" : 10,
          "scale" : 0,
          "type" : "NUMBER"
        } ],
        "orderBy" : [ {
          "direction" : "ASC",
          "fieldName" : "CloseDate"
        } ],
        "partitionBy" : [ "AccountId" ]
      },
      "sources" : [ "FORMULA13" ]
    },
    "FORMULA15" : {
      "action" : "computeRelative",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "sum(Id_formula2)",
          "label" : "# Won Opportunities on Account",
          "name" : "CountOfWonDeals",
          "precision" : 10,
          "scale" : 0,
          "type" : "NUMBER"
        } ],
        "orderBy" : [ {
          "direction" : "ASC",
          "fieldName" : "CloseDate"
        } ],
        "partitionBy" : [ "AccountId" ]
      },
      "sources" : [ "FORMULA14" ]
    },
    "FORMULA16" : {
      "action" : "computeRelative",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "sum(Id_formula2_formula)",
          "label" : "# Lost Opportunities on Account",
          "name" : "CountOfLostDeals",
          "precision" : 10,
          "scale" : 0,
          "type" : "NUMBER"
        } ],
        "orderBy" : [ {
          "direction" : "ASC",
          "fieldName" : "CloseDate"
        } ],
        "partitionBy" : [ "AccountId" ]
      },
      "sources" : [ "FORMULA15" ]
    },
