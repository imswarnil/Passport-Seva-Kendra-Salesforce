    "FORMULA1" : {
      "action" : "computeRelative",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "lag(Amount)",
          "label" : "AmountPrev",
          "name" : "AmountPrev",
          "precision" : 10,
          "scale" : 0,
          "type" : "NUMBER"
        } ],
        "orderBy" : [ {
          "direction" : "ASC",
          "fieldName" : "UniqueSort"
        } ],
        "partitionBy" : [ "OpportunityId" ]
      },
      "sources" : [ "FORMULA0" ]
    },
    "FORMULA2" : {
      "action" : "computeRelative",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "format" : "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
          "formulaExpression" : "to_date(lag(CloseDate))",
          "label" : "CloseDatePrev",
          "name" : "CloseDatePrev",
          "type" : "DATE_ONLY"
        } ],
        "orderBy" : [ {
          "direction" : "ASC",
          "fieldName" : "UniqueSort"
        } ],
        "partitionBy" : [ "OpportunityId" ]
      },
      "sources" : [ "FORMULA1" ]
    },
    "FORMULA3" : {
      "action" : "formula",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "case when AmountPrev < Amount then 1 else 0 end",
          "label" : "Amount_isIncreased",
          "name" : "AmountIsIncreased",
          "precision" : 10,
          "scale" : 0,
          "type" : "NUMBER"
        } ]
      },
      "sources" : [ "FORMULA2" ]
    },
    "FORMULA4" : {
      "action" : "formula",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "case when AmountPrev > Amount then 1 else 0 end",
          "label" : "Amount_isDecreased",
          "name" : "AmountIsDecreased",
          "precision" : 10,
          "scale" : 0,
          "type" : "NUMBER"
        } ]
      },
      "sources" : [ "FORMULA3" ]
    },
    "FORMULA5" : {
      "action" : "formula",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "case when CloseDatePrev < CloseDate then 1 else 0 end",
          "label" : "IsPushed",
          "name" : "IsPushed",
          "precision" : 10,
          "scale" : 0,
          "type" : "NUMBER"
        } ]
      },
      "sources" : [ "FORMULA4" ]
    },
