/**
 * 00-storage-check.apex
 *
 * Read-only. Prints row counts per PSK object, split into "total" and "demo"
 * (records generated by PSK_DemoDataGenerator). Run this BEFORE generating data:
 * a Developer Edition org holds roughly 2,500 records in ~5 MB, and this org
 * already carries the inherited Wave/Service-Analytics sample data plus ~1,005
 * Accounts.
 *
 *   sf apex run --file scripts/apex/00-storage-check.apex
 */
System.debug(LoggingLevel.ERROR, '\n' + PSK_DemoDataGenerator.storageReport());
