{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salesforce-passport",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  // ONE bucket named for the Worker, with a key prefix per kind of upload:
  //   resources/<userId>/<uuid>-<filename>
  //   guestbook/<userId>/<uuid>.png
  //   avatars/<userId>/...            (reserved; nothing writes this yet)
  // This replaced three buckets — psk-resources, psk-guestbook-attachments and
  // psk-avatars — on 2026-09-14. They were separate so that lifecycle rules and
  // access scoping could differ per kind, but R2 lifecycle rules take a prefix
  // condition, so a prefix buys the same thing without three root-level buckets
  // to keep in step. Nothing is served from a public bucket URL either: every
  // read goes through a Worker route that checks the DB first, so the per-bucket
  // settings (CORS, public access, custom domain) were never load-bearing here.
  // Create with:
  //   wrangler r2 bucket create salesforce-passport --location eeur
  "r2_buckets": [
    { "binding": "STORAGE", "bucket_name": "salesforce-passport" }
  ],
  // Secrets are NOT listed here — set them with `wrangler secret put <NAME>`.
  // The names carry Nuxt's `NUXT_` prefix because that is how runtimeConfig
  // in nuxt.config.ts is overridden at runtime; an unprefixed DATABASE_URL is
  // read by nothing. Required: NUXT_DATABASE_URL, NUXT_SESSION_SECRET.
  // Only for /demo-org: NUXT_SF_CLIENT_ID, NUXT_SF_USERNAME,
  // NUXT_SF_PRIVATE_KEY (plus NUXT_PUBLIC_DEMO_ORG_ENABLED=true).
  // See docs/SETUP_WEB.md and docs/SETUP_ORG.md.
  // The public hostname. A Custom Domain (not a plain route) so Cloudflare
  // manages the DNS record and the TLS cert for it. This replaced the
  // GitHub Pages record that used to serve this host — Pages could never
  // host this app, which needs Nitro's server routes, Neon and R2.
  // Keep the workers.dev URL alive alongside the custom domain. Without this
  // key wrangler DISABLES workers.dev on every deploy ("Because 'workers_dev'
  // is not in your Wrangler file, it will be disabled by default") — which
  // silently took the preview URL down to a Cloudflare placeholder page.
  "workers_dev": true,

  "routes": [
    { "pattern": "salesforce.imswarnil.com", "custom_domain": true }
  ],

  "observability": { "enabled": true }
}
